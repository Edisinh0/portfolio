---
import "@fontsource-variable/pixelify-sans";
import { translate } from "../../i18n/translations";
---

<header class="site-header" data-reveal="header">
	<div class="window-bar" aria-hidden="true">
		<img src="/windows.webp" alt="" />
		<div class="window-controls">
			<span class="window-control window-control--minimize"></span>
			<span class="window-control window-control--maximize"></span>
			<span class="window-control window-control--close"></span>
		</div>
	</div>

	<div class="header-content">
		<a
			class="brand"
			href="#inicio"
			aria-label={translate("header.brandHome")}
			data-i18n-attrs
			data-i18n-attr-aria-label="header.brandHome"
		>
			<img
				class="brand-icon"
				src="/images/icono_header.webp"
				alt={translate("header.brandIconAlt")}
				data-i18n-attrs
				data-i18n-attr-alt="header.brandIconAlt"
				width="112"
				height="112"
			/>

			<div class="brand-copy">
				<p class="brand-name">
					<span>PORTFOLIO</span><span class="brand-name-accent">.EXE</span>
				</p>
				
			</div>
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="primary-navigation"
		>
			<span class="menu-toggle-icon" aria-hidden="true"><i></i><i></i><i></i></span>
			<span data-i18n="header.menu">{translate("header.menu")}</span>
		</button>

		<nav
			class="main-nav"
			id="primary-navigation"
			aria-label={translate("header.navigation")}
			data-i18n-attrs
			data-i18n-attr-aria-label="header.navigation"
		>
			<a class="nav-link is-active" href="#inicio" aria-current="page">
				<img
					class="nav-icon"
					src="/header_icons/inicio.webp"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span data-i18n="header.home">{translate("header.home")}</span>
			</a>

			<a class="nav-link" href="#proyectos">
				<img
					class="nav-icon"
					src="/header_icons/proyectos.webp"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span data-i18n="header.projects">{translate("header.projects")}</span>
			</a>

			<a class="nav-link" href="#stack">
				<img
					class="nav-icon"
					src="/header_icons/tecnologias.webp"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span data-i18n="header.technologies">{translate("header.technologies")}</span>
			</a>

			<a class="nav-link" href="#sobre-mi">
				<img
					class="nav-icon"
					src="/header_icons/sobre_mi.webp"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span data-i18n="header.about">{translate("header.about")}</span>
			</a>

			<a class="nav-link" href="#contacto">
				<img
					class="nav-icon"
					src="/header_icons/contacto.webp"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span data-i18n="header.contact">{translate("header.contact")}</span>
			</a>

			<button
				class="language-toggle"
				type="button"
				aria-label={translate("header.switchToEnglish")}
				title={translate("header.switchToEnglish")}
				data-language-toggle
			>
				<img
					class="language-toggle-icon"
					src="/images/USA.webp"
					alt=""
					width="32"
					height="32"
					decoding="async"
					data-language-icon
				/>
				<span data-language-label>EN</span>
			</button>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
	const mainNav = document.querySelector<HTMLElement>(".main-nav");
	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
	const languageToggle = document.querySelector<HTMLButtonElement>("[data-language-toggle]");
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const mobileNavigation = window.matchMedia("(max-width: 700px)");
	const supportsSectionObserver = "IntersectionObserver" in window;
	const navigationTargets = navLinks
		.map((link) => ({
			hash: link.hash,
			target:
				link.hash === "#inicio"
					? document.querySelector<HTMLElement>(".hero")
					: document.querySelector<HTMLElement>(link.hash),
		}))
		.filter(
			(entry): entry is { hash: string; target: HTMLElement } => entry.target !== null,
		);
	const hashByTarget = new Map<Element, string>(
		navigationTargets.map(({ hash, target }) => [target, hash]),
	);
	const visibleSections = new Set<string>();
	let pendingScrollTarget: { hash: string; top: number } | undefined;
	let scrollEndFallback: number | undefined;
	let pendingScrollFrame: number | undefined;
	let fallbackScrollFrame: number | undefined;
	let sectionObserver: IntersectionObserver | undefined;
	let headerHeight = 0;
	let observerViewportHeight = 0;
	let currentActiveHash = "#inicio";

	const closeMenu = () => {
		mainNav?.classList.remove("is-open");
		menuToggle?.setAttribute("aria-expanded", "false");
	};

	const setActiveLink = (hash: string) => {
		currentActiveHash = hash;

		navLinks.forEach((link) => {
			const isActive = link.hash === hash;
			link.classList.toggle("is-active", isActive);

			if (isActive) {
				link.setAttribute("aria-current", "page");
			} else {
				link.removeAttribute("aria-current");
			}
		});
	};

	const updateActiveFromVisibleSections = () => {
		if (pendingScrollTarget) return;

		let activeHash = currentActiveHash;
		navigationTargets.forEach(({ hash }) => {
			if (visibleSections.has(hash)) activeHash = hash;
		});
		setActiveLink(activeHash);
	};

	const updateActiveLinkFallback = () => {
		if (pendingScrollTarget) return;

		const scrollMarker = window.scrollY + headerHeight + 16;
		let activeHash = "#inicio";

		navigationTargets.forEach(({ hash, target }) => {
			if (window.scrollY + target.getBoundingClientRect().top <= scrollMarker) {
				activeHash = hash;
			}
		});

		setActiveLink(activeHash);
	};

	const refreshSectionObserver = () => {
		if (!supportsSectionObserver) return;

		const availableHeight = Math.max(1, window.innerHeight - headerHeight - 1);
		const observerBandHeight = Math.min(
			availableHeight,
			Math.max(64, window.innerHeight * 0.35),
		);
		const bottomMargin = Math.max(
			0,
			window.innerHeight - headerHeight - observerBandHeight,
		);

		sectionObserver?.disconnect();
		visibleSections.clear();
		sectionObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const hash = hashByTarget.get(entry.target);
					if (!hash) return;

					if (entry.isIntersecting) {
						visibleSections.add(hash);
					} else {
						visibleSections.delete(hash);
					}
				});
				updateActiveFromVisibleSections();
			},
			{
				rootMargin: `-${Math.ceil(headerHeight + 1)}px 0px -${Math.ceil(bottomMargin)}px 0px`,
				threshold: 0,
			},
		);

		navigationTargets.forEach(({ target }) => sectionObserver?.observe(target));
	};

	const updateHeaderOffset = () => {
		const nextHeaderHeight = header?.offsetHeight ?? 0;
		const nextViewportHeight = window.innerHeight;
		document.documentElement.style.setProperty(
			"--sticky-header-height",
			`${nextHeaderHeight}px`,
		);

		if (
			nextHeaderHeight !== headerHeight ||
			nextViewportHeight !== observerViewportHeight
		) {
			headerHeight = nextHeaderHeight;
			observerViewportHeight = nextViewportHeight;
			refreshSectionObserver();
		}
	};

	const finishPendingScroll = () => {
		if (!pendingScrollTarget) return;

		pendingScrollTarget = undefined;
		if (scrollEndFallback) {
			window.clearTimeout(scrollEndFallback);
			scrollEndFallback = undefined;
		}

		updateActiveLinkFallback();
	};

	const scheduleScrollEndFallback = () => {
		if (!pendingScrollTarget) return;

		if (scrollEndFallback) window.clearTimeout(scrollEndFallback);
		scrollEndFallback = window.setTimeout(finishPendingScroll, 250);
	};

	const scrollToHash = (hash: string) => {
		const target = hash === "#inicio" ? undefined : document.querySelector<HTMLElement>(hash);
		if (hash !== "#inicio" && !target) return;

		const top = target
			? Math.max(0, window.scrollY + target.getBoundingClientRect().top - headerHeight - 3)
			: 0;
		pendingScrollTarget = { hash, top };

		window.scrollTo({
			top,
			behavior: reducedMotion.matches ? "auto" : "smooth",
		});

		window.requestAnimationFrame(() => {
			if (pendingScrollTarget && Math.abs(window.scrollY - pendingScrollTarget.top) <= 2) {
				finishPendingScroll();
			}
		});
	};

	if (header) {
		updateHeaderOffset();
		if ("ResizeObserver" in window) {
			new ResizeObserver(updateHeaderOffset).observe(header);
		}
		window.addEventListener("resize", updateHeaderOffset, { passive: true });
	} else {
		refreshSectionObserver();
	}

	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
		link.addEventListener("click", (event) => {
			const hash = link.hash;
			if (!hash) return;

			event.preventDefault();
			setActiveLink(hash);
			scrollToHash(hash);
			history.pushState(null, "", hash);
			closeMenu();
		});
	});

	menuToggle?.addEventListener("click", () => {
		const isOpen = mainNav?.classList.toggle("is-open") ?? false;
		menuToggle.setAttribute("aria-expanded", String(isOpen));
	});

	languageToggle?.addEventListener("click", () => {
		const currentLanguage = document.documentElement.lang === "en" ? "en" : "es";
		const nextLanguage = currentLanguage === "es" ? "en" : "es";

		window.dispatchEvent(
			new CustomEvent("portfolio:language-change", {
				detail: { language: nextLanguage },
			}),
		);
	});

	document.addEventListener("pointerdown", (event) => {
		if (mainNav?.classList.contains("is-open") && !header?.contains(event.target as Node)) {
			closeMenu();
		}
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && mainNav?.classList.contains("is-open")) {
			closeMenu();
			menuToggle?.focus();
		}
	});

	mobileNavigation.addEventListener("change", (event) => {
		if (!event.matches) closeMenu();
	});

	if (window.location.hash) setActiveLink(window.location.hash);

	window.addEventListener("hashchange", () => {
		if (window.location.hash) setActiveLink(window.location.hash);
	});

	window.addEventListener(
		"scroll",
		() => {
			if (!pendingScrollTarget) return;

			scheduleScrollEndFallback();
			if (pendingScrollFrame) return;

			pendingScrollFrame = window.requestAnimationFrame(() => {
				if (
					pendingScrollTarget &&
					Math.abs(window.scrollY - pendingScrollTarget.top) <= 2
				) {
					finishPendingScroll();
				}
				pendingScrollFrame = undefined;
			});
		},
		{ passive: true },
	);

	if (!supportsSectionObserver) {
		window.addEventListener(
			"scroll",
			() => {
				if (pendingScrollTarget || fallbackScrollFrame) return;

				fallbackScrollFrame = window.requestAnimationFrame(() => {
					updateActiveLinkFallback();
					fallbackScrollFrame = undefined;
				});
			},
			{ passive: true },
		);
		updateActiveLinkFallback();
	}

	window.addEventListener("scrollend", finishPendingScroll, { passive: true });
</script>

<style>
	.site-header {
		--forest: #0d4038;
		--ink: #181912;
		--paper: #e9d9b9;
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		border: 3px ridge #b8a27d;
		background-color: var(--paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 7%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 9%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 25px rgb(82 55 21 / 15%);
		color: var(--ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.window-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 32.4px;
		padding: 2.7px 7px 2.7px 10px;
		border-bottom: 3px ridge #b8a27d;
		background: var(--forest);
		box-shadow: inset 0 1px #2a675c, inset 0 -1px #06251f;
	}

	.window-bar > img {
		width: 23.4px;
		height: 23.4px;
		object-fit: contain;
		image-rendering: pixelated;
	}

	.window-controls {
		display: flex;
		gap: 5px;
	}

	.window-control {
		position: relative;
		display: block;
		width: 24.3px;
		height: 24.3px;
		border: 3px outset #d8c69f;
		background: #d5c39e;
		box-shadow: 1px 1px 0 #0a1915;
	}

	.window-control::before,
	.window-control::after {
		position: absolute;
		content: "";
		background: #17201b;
	}

	.window-control--minimize::before {
		left: 6px;
		right: 6px;
		bottom: 5px;
		height: 2px;
	}

	.window-control--maximize::before {
		inset: 4px;
		border: 2px solid #17201b;
		background: transparent;
	}

	.window-control--close::before,
	.window-control--close::after {
		top: 50%;
		left: 50%;
		width: 60%;
		height: 2px;
		transform-origin: center;
	}

	.window-control--close::before { transform: translate(-50%, -50%) rotate(45deg); }
	.window-control--close::after { transform: translate(-50%, -50%) rotate(-45deg); }

	.header-content {
		display: flex;
		min-height: 103.68px;
		align-items: center;
		justify-content: space-between;
		gap: clamp(24px, 5vw, 80px);
		padding: 8.91px clamp(22px, 4vw, 72px);
		border-bottom: 2px solid rgb(63 56 39 / 65%);
	}

	.brand {
		display: flex;
		min-width: max-content;
		align-items: center;
		gap: 18px;
		color: inherit;
		text-decoration: none;
	}

	.brand-icon {
		width: 87.48px;
		height: 87.48px;
		object-fit: contain;
		image-rendering: pixelated;
		filter: drop-shadow(3px 3px 0 rgb(49 41 24 / 35%));
	}

	.brand-copy { padding-top: 3px; }

	.brand-name {
		margin: 0;
		color: var(--forest);
		font-size: clamp(2rem, 2.8vw, 3.8rem);
		font-weight: 800;
		letter-spacing: 0.025em;
		line-height: 0.95;
		text-shadow: 2px 2px 0 rgb(23 53 45 / 12%);
	}

	.brand-name-accent { color: #7a301f; }

	.main-nav {
		display: flex;
		align-items: stretch;
		justify-content: flex-end;
		gap: clamp(8px, 1.5vw, 5px);
	}

	.menu-toggle {
		display: none;
	}

	.nav-link {
		display: inline-flex;
		min-height: 43.74px;
		align-items: center;
		gap: 11px;
		padding: 7.29px 13px;
		border: 2px solid transparent;
		color: #171914;
		font-size: clamp(1.05rem, 1.35vw, 1.5rem);
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: color 120ms ease, transform 120ms ease;
	}

	.nav-link:hover {
		color: #7a301f;
		transform: translateY(-2px);
	}

	.nav-link:focus-visible {
		outline: 3px dashed #7a301f;
		outline-offset: 3px;
	}

	.nav-link.is-active {
		border-color: #c4b18e;
		border-style: outset;
		background: rgb(199 184 153 / 55%);
		box-shadow: inset 0 0 12px rgb(67 52 29 / 9%);
	}

	.nav-icon {
		width: 27px;
		height: 27px;
		flex: 0 0 auto;
		object-fit: contain;
		image-rendering: pixelated;
		filter: drop-shadow(1px 1px 0 rgb(91 83 65 / 70%));
	}

	.language-toggle {
		display: inline-flex;
		min-height: 43.74px;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 6px 6px 6px 11px;
		border: 3px outset #d8c69f;
		background: #d5c39e;
		box-shadow: 2px 2px 0 #0a1915;
		color: var(--ink);
		font: inherit;
		font-size: clamp(1.05rem, 1.25vw, 1.35rem);
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: color 120ms ease, transform 120ms ease;
	}

	.language-toggle:hover {
		color: #7a301f;
		transform: translateY(-2px);
	}

	.language-toggle:active {
		border-style: inset;
		box-shadow: none;
		transform: translateY(0);
	}

	.language-toggle:focus-visible {
		outline: 3px dashed #7a301f;
		outline-offset: 3px;
	}

	.language-toggle-icon {
		width: 27px;
		height: 27px;
		flex: 0 0 auto;
		object-fit: contain;
		image-rendering: pixelated;
		filter: drop-shadow(1px 1px 0 rgb(91 83 65 / 70%));
	}

	@media (min-width: 1181px) and (max-height: 820px) {
		.window-bar {
			height: 29px;
			padding-block: 2px;
		}

		.window-bar > img {
			width: 21px;
			height: 21px;
		}

		.window-control {
			width: 24px;
			height: 24px;
		}

		.header-content {
			min-height: 84px;
			gap: clamp(20px, 4vw, 64px);
			padding: 6px clamp(20px, 3.5vw, 60px);
		}

		.brand {
			gap: 14px;
		}

		.brand-icon {
			width: 70px;
			height: 70px;
		}

		.brand-name {
			font-size: clamp(1.9rem, 2.35vw, 3rem);
		}

		.brand-tagline {
			font-size: clamp(0.85rem, 1.05vw, 1.05rem);
		}

		.main-nav {
			gap: clamp(6px, 1vw, 18px);
		}

		.nav-link {
			min-height: 38px;
			gap: 8px;
			padding: 6px 10px;
			font-size: clamp(1rem, 1.08vw, 1.2rem);
		}

		.nav-icon {
			width: 23px;
			height: 23px;
		}

		.language-toggle {
			min-height: 38px;
			gap: 7px;
			padding: 5px 5px 5px 9px;
			font-size: clamp(1rem, 1.08vw, 1.2rem);
		}

		.language-toggle-icon {
			width: 23px;
			height: 23px;
		}
	}

	@media (max-width: 1180px) {
		.header-content {
			flex-direction: column;
			gap: 6.48px;
			padding-block: 11.34px 14.58px;
		}

		.main-nav {
			width: 100%;
			justify-content: center;
		}
	}

	@media (min-width: 701px) and (max-width: 820px) {
		.main-nav { gap: 4px; }

		.nav-link {
			min-height: 38px;
			gap: 6px;
			padding: 5px 7px;
			font-size: 1rem;
		}

		.language-toggle {
			min-height: 38px;
			gap: 6px;
			padding: 5px 5px 5px 7px;
			font-size: 1rem;
		}

		.nav-icon,
		.language-toggle-icon {
			width: 23px;
			height: 23px;
		}
	}

	@media (max-width: 700px) {
		.window-bar { height: 27.9px; }
		.window-control { width: 22.5px; height: 22.5px; }

		.header-content {
			position: relative;
			min-height: 80px;
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
			padding: 10.2px 20px 8.75px;
		}

		.brand { gap: 5px; }
		.brand-icon { width: 45.16px; height: 56.86px; }
		.brand-name { font-size: clamp(1.55rem, 6.7vw, 2rem); }
		.brand-tagline { margin-top: 5.67px; font-size: clamp(0.78rem, 3.5vw, 1rem); }

		.menu-toggle {
			display: inline-flex;
			min-height: 38px;
			align-items: center;
			gap: 7px;
			margin-top: 6px;
			padding: 6px 9px;
			border: 3px outset #d8c69f;
			background: #d5c39e;
			box-shadow: 2px 2px 0 #0a1915;
			color: var(--ink);
			font: inherit;
			font-size: 1.05rem;
			font-weight: 700;
			line-height: 1;
			text-transform: uppercase;
			cursor: pointer;
		}

		.menu-toggle:hover,
		.menu-toggle[aria-expanded="true"] {
			border-style: inset;
			box-shadow: none;
			color: #7a301f;
		}

		.menu-toggle:focus-visible {
			outline: 3px dashed #7a301f;
			outline-offset: 3px;
		}

		.menu-toggle-icon {
			display: grid;
			width: 19px;
			gap: 3px;
		}

		.menu-toggle-icon i {
			display: block;
			height: 3px;
			background: currentColor;
			box-shadow: 1px 1px 0 rgb(255 255 255 / 35%);
		}

		.main-nav {
			display: none;
			position: absolute;
			top: calc(100% - 2px);
			left: 10px;
			right: 10px;
			width: auto;
			z-index: 1;
			flex-direction: column;
			gap: 3px;
			padding: 7px;
			border: 3px ridge #b8a27d;
			background-color: var(--paper);
			background-image:
				radial-gradient(circle at 15% 30%, rgb(96 72 39 / 7%) 0 1px, transparent 1.5px),
				radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px);
			box-shadow: 4px 4px 0 rgb(10 25 21 / 65%), inset 0 0 16px rgb(82 55 21 / 15%);
		}

		.main-nav.is-open {
			display: flex;
		}

		.nav-link {
			width: 100%;
			min-height: 37.26px;
			gap: 7px;
			padding: 5.67px 9px;
