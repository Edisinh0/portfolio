---
import "@fontsource-variable/pixelify-sans";
import GatoPixel from "../ui/GatoPixel.astro";
import ProjectsGallery from "../ui/ProjectsGallery.astro";
import { translate } from "../../i18n/translations";
---

<section
	class="projects"
	id="proyectos"
	aria-labelledby="projects-title"
	data-animated-section
>
	<img
		class="projects-vine"
		src="/images/planta_proyectos.webp"
		alt=""
		aria-hidden="true"
		loading="lazy"
		decoding="async"
	/>

	<div class="projects-shell">
		<header class="projects-heading" data-reveal>
			<img
				class="projects-section-icon"
				src="/header_icons/proyectos.webp"
				alt=""
				width="24"
				height="24"
				loading="lazy"
				decoding="async"
			/>
			<h2 id="projects-title" data-i18n="projects.title">{translate("projects.title")}</h2>
				
		</header>

		<div data-reveal style="--reveal-delay: 100ms">
			<ProjectsGallery />
		</div>
	</div>

	<div class="projects-paseo" aria-hidden="true">
		<GatoPixel
			gato="naranjo-camina"
			escala={3}
			recorre={{
				desde: "calc(100vw + 160px)",
				hasta: "-160px",
				duracion: "34s",
				reposo: "70vw",
			}}
		/>
	</div>
</section>

<style>
	.projects {
		--projects-paper: #eadabd;
		--projects-ink: #171914;
		position: relative;
		isolation: isolate;
		z-index: 0;
		width: 100%;
		padding: clamp(10px, 0.7vw, 40px) clamp(18px, 5vw, 80px) clamp(76px, 8vw, 120px);
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		background-color: var(--projects-paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 14%);
		color: var(--projects-ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.projects-vine {
		position: absolute;
		top: clamp(-125px, -8vw, -68px);
		right: clamp(-18px, 1.5vw, 28px);
		z-index: -1;
		width: clamp(100px, 8vw, 185px);
		height: auto;
		image-rendering: pixelated;
		pointer-events: none;
		user-select: none;
	}

	/*
	 * Carril del gato que cruza. El `overflow: hidden` es lo que impide que el
	 * recorrido empuje la barra de scroll horizontal de la página.
	 */
	.projects-paseo {
		position: absolute;
		z-index: 0;
		right: 0;
		bottom: clamp(14px, 2vw, 30px);
		left: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.projects-shell {
		width: min(100%, 1240px);
		margin-inline: auto;
	}

	.projects-heading {
		display: flex;
		max-width: 900px;
		margin-inline: auto;
		align-items: center;
		flex-direction: column;
		text-align: center;
	}

	.projects-section-icon {
		display: block;
		width: clamp(40px, 1.3vw, 24px);
		height: clamp(40px, 1.3vw, 24px);
		object-fit: contain;
		image-rendering: pixelated;
	}

	.projects-heading h2 {
		margin: 0;
		font-size: clamp(3rem, 4vw, 5.6rem);
		font-weight: 150;
		letter-spacing: 0.01em;
		line-height: 0.92;
		text-wrap: balance;
		text-shadow: 3px 3px 0 rgb(23 53 45 / 10%);
		padding-bottom: clamp(17px, 1.8vw, 24px);
		border-bottom: 2px dotted rgba(83, 63, 10, 0.48);
	}

	@media (min-width: 1181px) and (max-height: 820px) {
		.projects {
			padding-top: 28px;
			padding-bottom: 90px;
		}

		.projects-heading h2 {
			padding-bottom: 14px;
			font-size: clamp(2.7rem, 3.25vw, 4.25rem);
		}
	}

	@media (max-width: 560px) {
		.projects {
			padding-inline: 12px;
		}

		.projects-vine {
			top: -44px;
			left: -13px;
			width: 84px;
		}

		.projects-heading h2 {
			font-size: clamp(2.6rem, 13vw, 3.5rem);
		}
	}
</style>
