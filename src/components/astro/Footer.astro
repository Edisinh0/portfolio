---
import "@fontsource-variable/pixelify-sans";
import { translate } from "../../i18n/translations";

interface Props {
	homeHref?: string;
}

const { homeHref = "#inicio" } = Astro.props;

const initialTime = new Intl.DateTimeFormat("es-MX", {
	hour: "numeric",
	minute: "2-digit",
}).format(new Date());
---

<footer class="taskbar-footer">
	<a
		class="start-button"
		href={homeHref}
		aria-label={translate("footer.home")}
		data-i18n-attrs
		data-i18n-attr-aria-label="footer.home"
	>
		<img
			src="/images/icono_windows.webp"
			alt=""
			width="36"
			height="30"
			loading="lazy"
			decoding="async"
		/>
		<span data-i18n="footer.start">{translate("footer.start")}</span>
	</a>

	<span class="taskbar-divider divider-after-start" aria-hidden="true"></span>

	<div class="footer-messages">
		<p class="welcome-message" data-i18n="footer.welcome">{translate("footer.welcome")}</p>
		<span class="message-divider" aria-hidden="true">|</span>
		<p class="thanks-message">
			<span class="pixel-heart" aria-hidden="true">♥</span>
			<span data-i18n="footer.thanks">{translate("footer.thanks")}</span>
		</p>
	</div>

	<div class="system-tray">
		<span
			class="volume-icon"
			role="img"
			aria-label={translate("footer.volume")}
			data-i18n-attrs
			data-i18n-attr-aria-label="footer.volume"
		>
			<svg viewBox="0 0 30 24" aria-hidden="true">
				<path class="speaker" d="M3 9h5l6-5v16l-6-5H3z"></path>
				<path class="sound-wave" d="M18 8c1.4 1 2 2.3 2 4s-.6 3-2 4M21 5c2.2 1.8 3.3 4.1 3.3 7S23.2 17.2 21 19"></path>
			</svg>
		</span>
		<span class="taskbar-divider" aria-hidden="true"></span>
		<time class="clock" data-clock datetime={new Date().toISOString()}>{initialTime}</time>
	</div>
</footer>

<script>
	const clock = document.querySelector<HTMLTimeElement>("[data-clock]");

	if (clock) {
		const createFormatter = (language: string) =>
			new Intl.DateTimeFormat(language === "en" ? "en-US" : "es-MX", {
				hour: "numeric",
				minute: "2-digit",
			});
		let formatter = createFormatter(document.documentElement.lang);

		const updateClock = () => {
			const now = new Date();
			clock.textContent = formatter.format(now);
			clock.dateTime = now.toISOString();
		};

		updateClock();
		window.setInterval(updateClock, 15_000);
		window.addEventListener("portfolio:translations-applied", (event) => {
			if (!(event instanceof CustomEvent)) return;
			formatter = createFormatter(event.detail?.language ?? "es");
			updateClock();
		});
	}
</script>

<style>
	.taskbar-footer {
		--footer-green: #123f39;
		--footer-cream: #e1cfaa;
		display: flex;
		min-height: 63px;
		align-items: center;
		gap: 14px;
		padding: 7px 13px;
		border: 4px ridge #b5a078;
		background-color: var(--footer-green);
		background-image:
			radial-gradient(circle at 20% 30%, rgb(255 255 255 / 6%) 0 1px, transparent 1.4px),
			radial-gradient(circle at 70% 70%, rgb(0 0 0 / 9%) 0 1px, transparent 1.4px),
			linear-gradient(90deg, rgb(255 255 255 / 3%), transparent 40%, rgb(0 0 0 / 5%));
		background-size: 6px 6px, 8px 8px, 100% 100%;
		box-shadow:
			inset 0 2px #34665c,
			inset 0 -2px #082822,
			0 -2px 0 #5b5038;
		color: var(--footer-cream);
		font-family: "Pixelify Sans Variable", monospace;
		font-size: clamp(1rem, 1.25vw, 1.3rem);
		letter-spacing: 0.025em;
		text-shadow: 2px 2px 0 rgb(0 0 0 / 45%);
	}

	.start-button {
		display: inline-flex;
		min-height: 43px;
		flex: 0 0 auto;
		align-items: center;
		gap: 4px;
		padding: 3px 12px 3px 7px;
		border: 4px outset #dbc79f;
		background: #d6c19a;
		box-shadow: 2px 2px 0 rgb(3 21 17 / 75%);
		color: #181911;
		font-size: clamp(1.15rem, 1.5vw, 1.55rem);
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1;
		text-decoration: none;
		text-shadow: 1px 1px 0 rgb(255 255 255 / 45%);
	}

	.start-button:hover {
		background: #e1cda5;
	}

	.start-button:active {
		border-style: inset;
		box-shadow: none;
		transform: translate(1px, 1px);
	}

	.start-button:focus-visible {
		outline: 3px dashed #f2dfb8;
		outline-offset: 4px;
	}

	.start-button img {
		width: 36px;
		height: 30px;
		object-fit: cover;
		object-position: 78% center;
		image-rendering: pixelated;
	}

	.taskbar-divider {
		display: block;
		width: 2px;
		height: 38px;
		flex: 0 0 auto;
		background: #b9aa83;
		box-shadow: 2px 0 0 rgb(4 27 22 / 75%);
	}

	.footer-messages {
		display: flex;
		min-width: 0;
		flex: 1;
		align-items: center;
		gap: clamp(20px, 2.5vw, 42px);
	}

	.footer-messages p {
		margin: 0;
		white-space: nowrap;
	}

	.message-divider {
		color: #ddcead;
		font-size: 1.4em;
		line-height: 1;
	}

	.thanks-message {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.pixel-heart {
		color: #d94a45;
		font-family: monospace;
		font-size: 1.45em;
		line-height: 1;
		text-shadow:
			1px 0 #1c1912,
			-1px 0 #1c1912,
			0 1px #1c1912,
			0 -1px #1c1912,
			2px 2px 0 rgb(0 0 0 / 40%);
	}

	.system-tray {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 17px;
		margin-left: auto;
	}

	.volume-icon {
		display: inline-grid;
		width: 32px;
		height: 32px;
		place-items: center;
	}

	.volume-icon svg {
		width: 30px;
		height: 24px;
		overflow: visible;
		filter: drop-shadow(2px 2px 0 rgb(0 0 0 / 45%));
	}

	.speaker {
		fill: #c8b894;
		stroke: #151a15;
		stroke-linejoin: bevel;
		stroke-width: 1.4;
	}

	.sound-wave {
		fill: none;
		stroke: #c8b894;
		stroke-linecap: square;
		stroke-width: 2;
	}

	.clock {
		min-width: 5.3em;
		font-variant-numeric: tabular-nums;
		text-align: center;
		white-space: nowrap;
	}

	@media (max-width: 900px) {
		.taskbar-footer { gap: 10px; }
		.footer-messages { gap: 14px; }
		.welcome-message,
		.message-divider { display: none; }
	}

	@media (max-width: 580px) {
		.taskbar-footer {
			min-height: 56px;
			gap: 8px;
			padding: 6px 8px;
		}

		.divider-after-start { display: none; }
		.footer-messages { justify-content: center; }
		.thanks-message > :last-child { display: none; }
		.system-tray { gap: 10px; }
		.taskbar-divider { height: 31px; }
		.start-button { min-height: 38px; padding-right: 8px; border-width: 3px; }
		.start-button img { width: 29px; height: 26px; }
		.volume-icon { width: 28px; }
		.clock { min-width: 5em; }
	}

	@media (max-width: 390px) {
		.footer-messages { display: none; }
	}
</style>
