---
import "@fontsource-variable/pixelify-sans";
import "../styles/AboutWindow.css";
import "../styles/AboutTimeline.css";
import { translate, type TranslationKey } from "../../i18n/translations";

interface TimelineEntry {
	kind: "work" | "education";
	/** Atributo datetime del <time>: legible por máquina, no se traduce. */
	datetime: string;
	dateKey: TranslationKey;
	typeKey: TranslationKey;
	titleKey: TranslationKey;
	placeKey: TranslationKey;
	descriptionKey: TranslationKey;
}

const timeline: TimelineEntry[] = [
	{
		kind: "work",
		datetime: "2025-11",
		dateKey: "about.timeline.1.date",
		typeKey: "about.timeline.1.type",
		titleKey: "about.timeline.1.title",
		placeKey: "about.timeline.1.place",
		descriptionKey: "about.timeline.1.description",
	},
	{
		kind: "work",
		datetime: "2025-05",
		dateKey: "about.timeline.2.date",
		typeKey: "about.timeline.2.type",
		titleKey: "about.timeline.2.title",
		placeKey: "about.timeline.2.place",
		descriptionKey: "about.timeline.2.description",
	},
	{
		kind: "work",
		datetime: "2018",
		dateKey: "about.timeline.3.date",
		typeKey: "about.timeline.3.type",
		titleKey: "about.timeline.3.title",
		placeKey: "about.timeline.3.place",
		descriptionKey: "about.timeline.3.description",
	},
	{
		kind: "education",
		datetime: "2022",
		dateKey: "about.timeline.4.date",
		typeKey: "about.timeline.4.type",
		titleKey: "about.timeline.4.title",
		placeKey: "about.timeline.4.place",
		descriptionKey: "about.timeline.4.description",
	},
];
---

<section class="about render-deferred" id="sobre-mi" aria-labelledby="about-title">
	<div class="about-shell">
		<header class="about-heading" data-reveal>
			<img
				class="about-section-icon"
				src="/header_icons/sobre_mi.webp"
				alt=""
				width="24"
				height="24"
				loading="lazy"
				decoding="async"
			/>
			<h2 id="about-title" data-i18n="about.title">{translate("about.title")}</h2>
		</header>

		<article class="description-window" aria-labelledby="description-title" data-reveal style="--reveal-delay: 90ms">
			<header class="retro-titlebar">
				<span class="file-icon" aria-hidden="true">
					<span></span>
				</span>
				<h3 id="description-title" data-i18n="about.filename">
					{translate("about.filename")}
				</h3>

				<div class="window-controls" aria-hidden="true">
					<span class="window-control window-control--minimize"></span>
					<span class="window-control window-control--maximize"></span>
					<span class="window-control window-control--close"></span>
				</div>
			</header>

			<div class="description-body">
				<figure class="character">
					<svg
						viewBox="0 0 120 150"
						role="img"
						aria-label={translate("about.characterAlt")}
						data-i18n-attrs
						data-i18n-attr-aria-label="about.characterAlt"
						shape-rendering="crispEdges"
					>
						<rect x="18" y="10" width="84" height="130" fill="#c9c2ad" stroke="#171914" stroke-width="3" />
						<rect x="18" y="10" width="84" height="8" fill="#153e34" />
						<rect x="26" y="26" width="68" height="18" fill="#0d1a16" stroke="#171914" stroke-width="2" />
						<rect x="31" y="32" width="26" height="3" fill="#7bd88f" />
						<rect x="31" y="38" width="16" height="3" fill="#7bd88f" opacity="0.6" />
						<rect x="84" y="32" width="5" height="5" fill="#e0b341" />
						{
							[54, 68, 82, 96].map((y, index) => (
								<>
									<rect x="26" y={y} width="68" height="10" fill="#ded6c0" stroke="#171914" stroke-width="2" />
									<rect x="30" y={y + 3} width="18" height="4" fill="#b3a98d" />
									<rect x="84" y={y + 3} width="4" height="4" fill={index === 0 ? "#7bd88f" : "#8c2f25"} />
								</>
							))
						}
						<rect x="26" y="112" width="68" height="18" fill="#ded6c0" stroke="#171914" stroke-width="2" />
						<rect x="32" y="118" width="30" height="6" fill="#153e34" />
						<rect x="26" y="140" width="10" height="8" fill="#171914" />
						<rect x="84" y="140" width="10" height="8" fill="#171914" />
					</svg>
				</figure>

				<p>
					<span data-i18n="about.description.1">{translate("about.description.1")}</span>
					<br /><br />
					<span data-i18n="about.description.2">{translate("about.description.2")}</span>
				</p>
			</div>

			<footer
				class="window-status"
				aria-label={translate("about.fileStatus")}
				data-i18n-attrs
				data-i18n-attr-aria-label="about.fileStatus"
			>
				<span class="status-light" aria-hidden="true"></span>
				<span data-i18n="about.ready">{translate("about.ready")}</span>
			</footer>
		</article>

		<section class="journey" aria-labelledby="journey-title" data-reveal style="--reveal-delay: 120ms">
			<h3 class="visually-hidden" id="journey-title" data-i18n="about.journey">
				{translate("about.journey")}
			</h3>

			<ol class="timeline">
				{
					timeline.map((entry, index) => (
						<li
							class:list={["timeline-item", `timeline-item--${entry.kind}`]}
							data-reveal
							style={`--reveal-delay: ${80 + index * 70}ms`}
						>
							<span class="timeline-node" aria-hidden="true" />

							<div class="date-stamp">
								<span class="calendar-icon" aria-hidden="true">
									<span />
								</span>
								<time datetime={entry.datetime} data-i18n={entry.dateKey}>
									{translate(entry.dateKey)}
								</time>
							</div>

							<article class="timeline-card">
								<div class="card-controls" aria-hidden="true">
									<span />
									<span />
									<span />
								</div>
								<p class="entry-type" data-i18n={entry.typeKey}>
									{translate(entry.typeKey)}
								</p>
								<h4 data-i18n={entry.titleKey}>{translate(entry.titleKey)}</h4>
								<p class="entry-place" data-i18n={entry.placeKey}>
									{translate(entry.placeKey)}
								</p>
								<p class="entry-description" data-i18n={entry.descriptionKey}>
									{translate(entry.descriptionKey)}
								</p>
							</article>
						</li>
					))
				}
			</ol>
		</section>
	</div>
</section>

<style>
	.about {
		--about-paper: #eadabd;
		--about-ink: #171914;
		--about-forest: #153e34;
		--about-red: #8c2f25;
		width: 100%;
		padding: clamp(10px, 0.7vw, 40px) clamp(18px, 5vw, 80px) clamp(76px, 8vw, 120px);
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		background-color: var(--about-paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 14%);
		color: var(--about-ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.about-shell {
		width: min(100%, 1240px);
		margin-inline: auto;
	}

	.about-heading {
		display: flex;
		max-width: 900px;
		margin-inline: auto;
		align-items: center;
		flex-direction: column;
		text-align: center;
	}

	.about-section-icon {
		display: block;
		width: clamp(40px, 1.3vw, 24px);
		height: clamp(40px, 1.3vw, 24px);
		object-fit: contain;
		image-rendering: pixelated;
	}

	.about-heading h2 {
		margin: 0;
		padding-bottom: clamp(17px, 1.8vw, 24px);
		border-bottom: 2px dotted rgb(83 63 10 / 48%);
		font-size: clamp(3rem, 4vw, 5.6rem);
		font-weight: 150;
		letter-spacing: 0.01em;
		line-height: 0.92;
		text-shadow: 3px 3px 0 rgb(23 53 45 / 10%);
		text-wrap: balance;
	}

	@media (min-width: 1181px) and (max-height: 820px) {
		.about {
			padding-top: 28px;
			padding-bottom: 100px;
		}

		.about-heading h2 {
			padding-bottom: 14px;
			font-size: clamp(2.7rem, 3.25vw, 4.25rem);
		}
	}

	@media (max-width: 620px) {
		.about {
			padding-inline: 12px;
		}
	}

	@media (max-width: 440px) {
		.about-heading h2 {
			font-size: clamp(2.6rem, 13vw, 3.5rem);
		}
	}
</style>
