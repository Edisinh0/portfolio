---
import "@fontsource-variable/pixelify-sans";
import CodeTerminal from "../ui/CodeTerminal.astro";
import { translate } from "../../i18n/translations";
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-art" aria-hidden="true" data-reveal="hero" style="--reveal-delay: 80ms">
		<div class="hero-windows">
			<span class="hero-window hero-window--notes"></span>
			<span class="hero-window hero-window--landscape"></span>
		</div>
	</div>

	<img
		class="hero-plants"
		src="/images/plantas_hero.webp"
		alt=""
		width="495"
		height="2145"
		aria-hidden="true"
		data-reveal="hero"
		style="--reveal-delay: 140ms"
	/>

	<div class="hero-copy" data-reveal="hero" style="--reveal-delay: 210ms">
		{/*
		  Retrato pendiente. Cuando exista la foto, dejarla en
		  `public/images/foto_perfil.webp` y reemplazar este SVG por:
		  <img class="hero-profile" src="/images/foto_perfil.webp" alt={translate("hero.profileAlt")}
		       data-i18n-attrs data-i18n-attr-alt="hero.profileAlt" loading="eager" decoding="async" />
		*/}
		<svg
			class="hero-profile"
			viewBox="0 0 64 64"
			role="img"
			aria-label={translate("hero.profileAlt")}
			data-i18n-attrs
			data-i18n-attr-aria-label="hero.profileAlt"
			shape-rendering="crispEdges"
		>
			<rect width="64" height="64" fill="#d8cdb2" />
			<rect x="20" y="14" width="24" height="22" fill="#8c6a4a" />
			<rect x="24" y="10" width="16" height="8" fill="#3a2b1f" />
			<rect x="18" y="18" width="4" height="10" fill="#3a2b1f" />
			<rect x="42" y="18" width="4" height="10" fill="#3a2b1f" />
			<rect x="26" y="23" width="4" height="4" fill="#171914" />
			<rect x="34" y="23" width="4" height="4" fill="#171914" />
			<rect x="28" y="31" width="8" height="2" fill="#5c3b2a" />
			<rect x="14" y="40" width="36" height="24" fill="#153e34" />
			<rect x="26" y="36" width="12" height="6" fill="#8c6a4a" />
			<rect x="28" y="40" width="8" height="12" fill="#d8cdb2" />
		</svg>
		<h1 id="hero-title" data-i18n="hero.title">{translate("hero.title")}</h1>
		<p class="hero-role" data-i18n="hero.role">{translate("hero.role")}</p>
		<p class="hero-description" data-i18n="hero.description">
			{translate("hero.description")}
		</p>
	</div>

	<CodeTerminal />

	<div
		class="hero-actions"
		role="group"
		aria-label={translate("hero.actions")}
		data-i18n-attrs
		data-i18n-attr-aria-label="hero.actions"
		data-reveal="hero"
		style="--reveal-delay: 340ms"
	>
		<a class="hero-button hero-button--primary" href="#proyectos">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8 5v14l11-7z" />
			</svg>
			<span data-i18n="hero.viewProjects">{translate("hero.viewProjects")}</span>
		</a>

		<a class="hero-button" href="#contacto">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M3 5.5h18v13H3zM4 7l8 6 8-6M4 18l5.5-6M20 18l-5.5-6" />
			</svg>
			<span data-i18n="hero.contact">{translate("hero.contact")}</span>
		</a>

		<div class="cv-menu" data-cv-menu>
			<button
				type="button"
				class="hero-button hero-button--cv"
				data-cv-toggle
				aria-expanded="false"
				aria-controls="cv-idiomas"
				title={translate("hero.downloadCv")}
				data-i18n-attrs
				data-i18n-attr-title="hero.downloadCv"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 2.5h8l4 4v15H6zM14 2.5v4h4M9 12h6M9 16h6" />
				</svg>
				<span>CV</span>
				<span class="cv-menu__caret" aria-hidden="true">▾</span>
			</button>

			{/*
			 * Los nombres de los idiomas van cada uno en su propio idioma y no
			 * traducidos: quien busca el CV en inglés reconoce "English" aunque
			 * el sitio esté en español. Por eso tampoco pasan por el i18n.
			 */}
			<div
				class="cv-menu__list"
				id="cv-idiomas"
				data-cv-list
				hidden
				aria-label={translate("hero.downloadCv")}
				data-i18n-attrs
				data-i18n-attr-aria-label="hero.downloadCv"
			>
				<a href="/cv.html" target="_blank" rel="noreferrer" lang="es">Español</a>
				<a href="/cv-en.html" target="_blank" rel="noreferrer" lang="en">English</a>
			</div>
		</div>
	</div>

</section>

<style>
	.hero {
		--forest: #16483c;
		--ink: #171914;
		--paper: #eadabd;
		/* Ancho libre a la izquierda de la terminal flotante. */
		--hero-copy-safe: calc(74vw - clamp(300px, 32vw, 460px) - 24px);
		position: relative;
		isolation: isolate;
		z-index: 1;
		width: 100%;
		height: calc(100svh - var(--sticky-header-height, 144px));
		min-height: 540px;
		overflow: hidden;
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		background-color: var(--paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 16%);
		color: var(--ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.hero::after {
		position: absolute;
		z-index: 4;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		background: rgb(49 40 25 / 48%);
		content: "";
	}

	.hero-art {
		position: absolute;
		z-index: 1;
		right: 0;
		bottom: 0;
		left: auto;
		height: min(100%, 59.389vw);
		aspect-ratio: 1665 / 899;
		transform: none;
		pointer-events: none;
		user-select: none;
	}

	.hero-windows {
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
	}

	.hero-window {
		position: absolute;
		display: block;
		height: auto;
		background-position: center;
		background-repeat: no-repeat;
		background-size: 100% 100%;
		filter: drop-shadow(4px 5px 2px rgb(45 34 18 / 28%));
		user-select: none;
	}

	.hero-window--notes {
		top: 6%;
		right: 7%;
		width: 15.25%;
		aspect-ratio: 1174 / 795;
	}

	.hero-window--landscape {
		top: 45.5%;
		left: 76%;
		width: 22.25%;
		aspect-ratio: 1359 / 1013;
	}

	@media (min-width: 781px) {
		.hero-window--notes {
			background-image: url("/images/notas_txt.webp");
		}

		.hero-window--landscape {
			background-image: url("/images/tren.webp");
		}
	}

	.hero-plants {
		position: absolute;
		z-index: 2;
		bottom: 0;
		left: 0;
		display: block;
		width: auto;
		height: 100%;
		filter: drop-shadow(3px 2px 2px rgb(31 43 18 / 22%));
		image-rendering: pixelated;
		pointer-events: none;
		user-select: none;
	}

	.hero-copy {
		position: absolute;
		z-index: 3;
		top: 4%;
		left: 6%;
		width: 49%;
		text-shadow: 2px 2px 0 rgb(23 53 45 / 10%);
	}

	.hero-profile {
		display: block;
		width: clamp(104px, 9vw, 142px);
		aspect-ratio: 1;
		margin: 0 auto clamp(8px, 0.8vw, 14px);
		object-fit: cover;
		object-position: center;
		image-rendering: pixelated;
		clip-path: polygon(
			0 18%,
			8% 18%,
			8% 8%,
			18% 8%,
			18% 0,
			82% 0,
			82% 8%,
			92% 8%,
			92% 18%,
			100% 18%,
			100% 82%,
			92% 82%,
			92% 92%,
			82% 92%,
			82% 100%,
			18% 100%,
			18% 92%,
			8% 92%,
			8% 82%,
			0 82%
		);
	}

	.hero-copy h1 {
		margin: 0;
		font-size: clamp(3.6rem, 5.45vw, 6.05rem);
		font-weight: 750;
		letter-spacing: 0.012em;
		line-height: 0.95;
	}

	.hero-role {
		margin: clamp(16px, 2vw, 30px) 0 0;
		color: var(--forest);
		font-size: clamp(1.55rem, 2.45vw, 2.65rem);
		font-weight: 650;
		letter-spacing: 0.01em;
		line-height: 1.04;
	}

	.hero-description {
		max-width: 700px;
		margin: clamp(22px, 2.1vw, 32px) 0 0;
		padding-top: clamp(18px, 1.5vw, 24px);
		border-top: 2px dotted rgb(56 50 35 / 45%);
		color: #000;
		font-family: Consolas, "Courier New", monospace;
		font-size: clamp(0.85rem, 0.95vw, 2rem);
		font-weight: 400;
		letter-spacing: 0.01em;
		line-height: 1.45;
		text-wrap: pretty;
	}

	.hero-actions {
		position: absolute;
		z-index: 3;
		top: 70%;
		left: 6%;
		display: flex;
		align-items: stretch;
		gap: clamp(12px, 1.7vw, 27px);
	}

	.hero-button {
		display: inline-flex;
		min-width: clamp(150px, 13.8vw, 215px);
		height: clamp(52px, 4.35vw, 68px);
		align-items: center;
		justify-content: center;
		gap: 13px;
		padding: 8px clamp(18px, 1.7vw, 29px);
		border: 3px outset #c9b998;
		background: rgb(224 210 183 / 92%);
		box-shadow: 3px 4px 0 rgb(45 39 26 / 35%), inset 0 0 13px rgb(94 72 39 / 8%);
		color: var(--ink);
		font: inherit;
		font-size: clamp(1.15rem, 1.5vw, 1.6rem);
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: filter 120ms ease, transform 120ms ease, box-shadow 120ms ease;
	}

	.hero-button--primary {
		border-color: #668675;
		background: #174b3e;
		box-shadow: 3px 4px 0 rgb(35 39 28 / 46%), inset 0 0 0 2px #9daf93;
		color: #f0e8d6;
	}

	.hero-button--cv {
		min-width: clamp(92px, 8vw, 125px);
	}

	.hero-button svg {
		width: 25px;
		height: 25px;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 1.8;
	}

	.hero-button--primary svg {
		fill: currentColor;
		stroke: none;
	}

	.hero-button:hover {
		filter: brightness(1.06);
		transform: translateY(-2px);
		box-shadow: 3px 6px 0 rgb(45 39 26 / 32%), inset 0 0 13px rgb(94 72 39 / 8%);
	}

	.hero-button--primary:hover {
		box-shadow: 3px 6px 0 rgb(35 39 28 / 40%), inset 0 0 0 2px #9daf93;
	}

	.hero-button:active {
		border-style: inset;
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 rgb(45 39 26 / 30%);
	}

	.hero-button:focus-visible {
		outline: 3px dashed #7a301f;
		outline-offset: 5px;
	}

	/*
	 * En escritorio la terminal flota sobre el hero y su borde izquierdo cae
	 * dentro del ancho de .hero-copy, así que las líneas largas quedaban
	 * cortadas por debajo. `--hero-copy-safe` reproduce la posición de ese
	 * borde (izquierda de la terminal menos el margen de la columna) para que
	 * el párrafo corte antes. Si se mueve la terminal, ajustar aquí también.
	 */
	@media (min-width: 1181px) {
		.hero-description {
			max-width: var(--hero-copy-safe);
		}
	}

	@media (min-width: 1181px) and (max-height: 820px) {
		.hero-copy {
			top: 4%;
			width: 47%;
		}

		.hero-profile {
			width: clamp(96px, 8vw, 118px);
			margin-bottom: 8px;
		}

		.hero-copy h1 {
			font-size: clamp(3.2rem, 4.35vw, 4.75rem);
		}

		.hero-role {
			margin-top: clamp(12px, 1.4vw, 20px);
			font-size: clamp(1.35rem, 1.95vw, 2.05rem);
		}

		.hero-description {
			max-width: min(580px, var(--hero-copy-safe));
			margin-top: clamp(14px, 1.4vw, 20px);
			padding-top: clamp(12px, 1vw, 16px);
			font-size: clamp(0.875rem, 0.85vw, 0.95rem);
			line-height: 1.4;
		}

		.hero-actions {
			top: 68%;
			gap: 18px;
		}

		.hero-button {
			min-width: clamp(140px, 11.5vw, 180px);
			height: 54px;
			gap: 10px;
			padding: 7px 18px;
			font-size: clamp(1rem, 1.2vw, 1.25rem);
		}

		.hero-button--cv {
			min-width: clamp(90px, 7vw, 105px);
		}

		.hero-button svg {
			width: 22px;
			height: 22px;
		}
	}

	@media (max-width: 1180px) {
		.hero {
			height: calc(100svh - var(--sticky-header-height, 202px));
			min-height: 520px;
		}

		.hero-copy {
			top: 5%;
			width: 52%;
		}

		.hero-copy h1 {
			font-size: clamp(3.4rem, 5.35vw, 4.5rem);
		}

		.hero-role {
			font-size: clamp(1.45rem, 2.35vw, 2rem);
		}

		.hero-description {
			max-width: 58vw;
			font-size: clamp(0.82rem, 1.25vw, 0.95rem);
		}

		.hero-actions {
			top: 67%;
			gap: 13px;
		}

		.hero-button {
			min-width: 0;
			padding-inline: 18px;
		}
	}

	@media (max-width: 780px) {
		.hero {
			display: flex;
			height: auto;
			min-height: max(600px, calc(100svh - var(--sticky-header-height, 104px)));
			flex-direction: column;
			padding: clamp(28px, 7vw, 42px) 6vw clamp(30px, 8vw, 48px)
				clamp(54px, 16vw, 78px);
		}

		.hero-art {
			display: none;
		}

		.hero-plants {
			z-index: 1;
			left: 19%;
			height: 100%;
			transform: translateX(-55%);
		}

		.hero-copy {
			position: relative;
			top: auto;
			left: auto;
			width: 100%;
			max-width: 620px;
			text-shadow: 1px 1px 0 rgb(23 53 45 / 10%);
		}

		.hero-profile {
			width: clamp(88px, 25vw, 112px);
			margin-bottom: clamp(14px, 4vw, 20px);
		}

		.hero-copy h1 {
			max-width: 11ch;
			margin-inline: auto;
			font-size: clamp(2.75rem, 12vw, 4.3rem);
			letter-spacing: 0;
			line-height: 0.98;
			text-align: center;
			text-wrap: balance;
		}

		.hero-role {
			max-width: 24ch;
			margin: clamp(16px, 4vw, 22px) auto 0;
			font-size: clamp(1.25rem, 5.6vw, 1.85rem);
			line-height: 1.12;
			text-align: center;
			text-wrap: balance;
		}

		.hero-description {
			display: block;
			width: 100%;
			max-width: 46ch;
			margin: clamp(18px, 5vw, 26px) auto 0;
			padding-top: clamp(14px, 4vw, 20px);
			padding-left: 2%;
			font-size: clamp(0.86rem, 2.6vw, 1rem);
			font-weight: 500;
			line-height: 1.5;
			text-align: left;
			text-wrap: pretty;
		}

		.hero-actions {
			position: relative;
			top: auto;
			left: auto;
			display: grid;
			width: 100%;
			max-width: 560px;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(10px, 3vw, 14px);
			margin-top: clamp(28px, 8vw, 46px);
		}

		.hero-button {
			width: 100%;
			height: 52px;
			min-width: 0;
			gap: 9px;
			padding-inline: clamp(10px, 3vw, 18px);
			font-size: 1.1rem;
		}

		.hero-button--cv {
			width: max(112px, calc(50% - 7px));
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 480px) {
		.hero {
			min-height: max(580px, calc(100svh - var(--sticky-header-height, 104px)));
			padding-top: 24px;
			padding-right: 18px;
			padding-bottom: 30px;
			padding-left: clamp(48px, 15vw, 62px);
		}

		.hero-copy h1 {
			font-size: clamp(2.55rem, 12vw, 3.25rem);
		}

		.hero-role {
			font-size: clamp(1.18rem, 5.8vw, 1.55rem);
		}

		.hero-description {
			margin-top: 18px;
			padding-top: 14px;
			font-size: clamp(0.84rem, 3.8vw, 0.94rem);
			line-height: 1.48;
			font-weight: 500;
		}

		.hero-actions {
			gap: 10px;
			margin-top: 26px;
		}

		.hero-button {
			height: 48px;
			gap: 8px;
			padding-inline: 9px;
			font-size: clamp(0.9rem, 4vw, 1rem);
		}

		.hero-button svg {
			width: 20px;
			height: 20px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-button {
			transition: none;
		}
	}

	/* ── Menú de idioma del CV ─────────────────────────────────────────── */

	.cv-menu {
		position: relative;
		display: inline-flex;
	}

	.cv-menu__caret {
		margin-left: -4px;
		font-size: 0.8em;
		line-height: 1;
	}

	/*
	 * Cuelga del botón sin empujar la fila. El ancho mínimo lo marca el
	 * propio botón para que el desplegable nunca salga más angosto que él.
	 */
	.cv-menu__list {
		position: absolute;
		z-index: 20;
		top: calc(100% + 6px);
		left: 0;
		display: flex;
		min-width: 100%;
		flex-direction: column;
		border: 3px outset #c9b998;
		background: rgb(224 210 183 / 97%);
		box-shadow: 3px 4px 0 rgb(45 39 26 / 35%);
	}

	.cv-menu__list[hidden] {
		display: none;
	}

	.cv-menu__list a {
		padding: 11px 18px;
		color: var(--ink);
		font-size: clamp(1rem, 1.2vw, 1.25rem);
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.cv-menu__list a + a {
		border-top: 2px groove #c0ad8b;
	}

	.cv-menu__list a:hover,
	.cv-menu__list a:focus-visible {
		background: #17483c;
		color: #f0e8d6;
	}

	.cv-menu__list a:focus-visible {
		outline: 3px dashed #f0d69f;
		outline-offset: -5px;
	}
</style>

<script>
	/*
	 * El botón del CV abre un menú con los dos idiomas en vez de descargar
	 * uno directo. Se cierra al elegir, al hacer clic fuera y con Escape,
	 * devolviendo el foco al botón — si no, al cerrar con teclado el foco
	 * queda suelto al final del documento.
	 */
	const menu = document.querySelector<HTMLElement>("[data-cv-menu]");
	const toggle = menu?.querySelector<HTMLButtonElement>("[data-cv-toggle]");
	const list = menu?.querySelector<HTMLElement>("[data-cv-list]");

	if (menu && toggle && list) {
		const setOpen = (open: boolean) => {
			list.hidden = !open;
			toggle.setAttribute("aria-expanded", String(open));
		};

		toggle.addEventListener("click", () => {
			setOpen(list.hidden);
		});

		list.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) setOpen(false);
		});

		document.addEventListener("click", (event) => {
			if (!menu.contains(event.target as Node)) setOpen(false);
		});

		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || list.hidden) return;
			setOpen(false);
			toggle.focus();
		});
	}
</script>
