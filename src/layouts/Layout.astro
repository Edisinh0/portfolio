---
import "../styles/global.css";
import {
	translate,
	translations,
	type TranslationKey,
} from "../i18n/translations";

interface Props {
	title?: string;
	description?: string;
	titleKey?: TranslationKey;
	descriptionKey?: TranslationKey;
	preloadImage?: string;
	preloadMedia?: string;
}

const {
	title = translate("meta.home.title"),
	description = translate("meta.home.description"),
	titleKey,
	descriptionKey,
	preloadImage,
	preloadMedia,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.url);
const ogImageUrl = new URL("/images/icono_windows.webp", Astro.url);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/windows.webp" />
		{
			preloadImage && (
				<link
					rel="preload"
					as="image"
					href={preloadImage}
					media={preloadMedia}
					fetchpriority="high"
				/>
			)
		}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={description}
			data-i18n-attrs={descriptionKey ? "" : undefined}
			data-i18n-attr-content={descriptionKey}
		/>
		<meta
			property="og:title"
			content={title}
			data-i18n-attrs={titleKey ? "" : undefined}
			data-i18n-attr-content={titleKey}
		/>
		<meta
			property="og:description"
			content={description}
			data-i18n-attrs={descriptionKey ? "" : undefined}
			data-i18n-attr-content={descriptionKey}
		/>
		<meta property="og:image" content={ogImageUrl.href} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:type" content="website" />
		<title data-i18n={titleKey}>{title}</title>
		<script is:inline>
			document.documentElement.classList.add("js");

			try {
				const storedLanguage = localStorage.getItem("portfolio-language");
				if (storedLanguage === "es" || storedLanguage === "en") {
					document.documentElement.lang = storedLanguage;
				}
			} catch {
				// El contenido mantiene el idioma inicial si el almacenamiento está bloqueado.
			}

			const navigationEntry = performance.getEntriesByType("navigation")[0];
			const isReload = navigationEntry?.type === "reload";
			const isStartHash = window.location.hash === "#inicio";
			const shouldResetScroll = (isReload && !window.location.hash) || isStartHash;

			if (shouldResetScroll && "scrollRestoration" in history) {
				history.scrollRestoration = "manual";

				window.addEventListener(
					"pageshow",
					() => {
						requestAnimationFrame(() => {
							requestAnimationFrame(() => {
								const previousScrollBehavior =
									document.documentElement.style.scrollBehavior;

								document.documentElement.style.scrollBehavior = "auto";
								window.scrollTo(0, 0);
								document.documentElement.style.scrollBehavior =
									previousScrollBehavior;
								history.scrollRestoration = "auto";
							});
						});
					},
					{ once: true },
				);
			}
		</script>
		<slot name="head" />
	</head>
	<body>
		<slot />

		<script>
			const revealTargets = Array.from(
				document.querySelectorAll<HTMLElement>("[data-reveal]"),
			);
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

			const reveal = (element: HTMLElement) => {
				element.dataset.revealed = "";
			};

			if (reducedMotion.matches || !("IntersectionObserver" in window)) {
				revealTargets.forEach(reveal);
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							reveal(entry.target as HTMLElement);
							observer.unobserve(entry.target);
						});
					},
					{
						rootMargin: "0px 0px -15% 0px",
						threshold: 0.08,
					},
				);

				revealTargets.forEach((element) => observer.observe(element));
			}
		</script>

		<script is:inline define:vars={{ translations }}>
			const languageStorageKey = "portfolio-language";
			const supportedLanguages = ["es", "en"];

			const isSupportedLanguage = (language) =>
				supportedLanguages.includes(language);

			const updateLanguageControl = (language, dictionary) => {
				const languageToggle = document.querySelector("[data-language-toggle]");
				if (!(languageToggle instanceof HTMLButtonElement)) return;

				const targetLanguage = language === "es" ? "en" : "es";
				const targetKey =
					targetLanguage === "en"
						? "header.switchToEnglish"
						: "header.switchToSpanish";
				const accessibleLabel = dictionary[targetKey];
				const icon = languageToggle.querySelector("[data-language-icon]");
				const label = languageToggle.querySelector("[data-language-label]");

				languageToggle.dataset.currentLanguage = language;
				languageToggle.setAttribute("aria-label", accessibleLabel);
				languageToggle.setAttribute("title", accessibleLabel);
				if (icon instanceof HTMLImageElement) {
					icon.src = targetLanguage === "en" ? "/images/USA.webp" : "/images/MEX.webp";
				}
				if (label) label.textContent = targetLanguage.toUpperCase();
			};

			const applyTranslations = (language, persist = true) => {
				if (!isSupportedLanguage(language)) return;

				const dictionary = translations[language];
				document.documentElement.lang = language;

				document.querySelectorAll("[data-i18n]").forEach((element) => {
					const key = element.getAttribute("data-i18n");
					if (key && dictionary[key] !== undefined) {
						element.textContent = dictionary[key];
					}
				});

				document.querySelectorAll("[data-i18n-attrs]").forEach((element) => {
					Array.from(element.attributes).forEach((attribute) => {
						const prefix = "data-i18n-attr-";
						if (!attribute.name.startsWith(prefix)) return;

						const translatedValue = dictionary[attribute.value];
						if (translatedValue === undefined) return;

						const targetAttribute = attribute.name.slice(prefix.length);
						element.setAttribute(targetAttribute, translatedValue);
					});
				});

				updateLanguageControl(language, dictionary);

				if (persist) {
					try {
						localStorage.setItem(languageStorageKey, language);
					} catch {
						// El cambio se conserva durante la sesión aunque no se pueda persistir.
					}
				}

				window.dispatchEvent(
					new CustomEvent("portfolio:translations-applied", {
						detail: { language },
					}),
				);
			};

			window.addEventListener("portfolio:language-change", (event) => {
				applyTranslations(event.detail?.language);
			});

			window.addEventListener("storage", (event) => {
				if (
					event.key === languageStorageKey &&
					event.newValue &&
					isSupportedLanguage(event.newValue)
				) {
					applyTranslations(event.newValue, false);
				}
			});

			const initialLanguage = isSupportedLanguage(document.documentElement.lang)
				? document.documentElement.lang
				: "es";
			applyTranslations(initialLanguage, false);
		</script>
	</body>
</html>
