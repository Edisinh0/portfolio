{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "WHM Provisioning: a full day of setup down to an hour",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1070,
      566
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Provisioning phases"
    },
    {
      "id": "event",
      "label": "Recovery"
    }
  ],
  "states": [
    {
      "id": "bare",
      "type": "start",
      "label": "Bare server",
      "sublabel": "nothing installed",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "waiting"
    },
    {
      "id": "install",
      "type": "active",
      "label": "Unattended install",
      "sublabel": "AlmaLinux 9 kickstart",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "automated"
    },
    {
      "id": "standard",
      "type": "active",
      "label": "Standard applied",
      "sublabel": "WHM · CSF · PHP",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "scripted"
    },
    {
      "id": "check",
      "type": "decision",
      "label": "Health check",
      "sublabel": "services verified",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "gate"
    },
    {
      "id": "ready",
      "type": "success",
      "label": "Ready to hand over",
      "sublabel": "identical every time",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "done"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Check failed",
      "sublabel": "a service did not come up",
      "lane": "event",
      "col": 1,
      "tag": "retry"
    }
  ],
  "transitions": [
    {
      "from": "bare",
      "to": "install",
      "label": "kickstart",
      "route": "straight",
      "labelDy": -25
    },
    {
      "from": "install",
      "to": "standard",
      "label": "setup script",
      "route": "straight",
      "labelDy": -25
    },
    {
      "from": "standard",
      "to": "check",
      "route": "straight"
    },
    {
      "from": "check",
      "to": "ready",
      "label": "all up",
      "variant": "emphasis",
      "labelDy": -25
    },
    {
      "from": "check",
      "to": "failed",
      "label": "service down",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "from": "failed",
      "to": "standard",
      "label": "reapply"
    }
  ]
}
